{
    "permissions": {
        "allow": [
            "Read(./**)",
            "Edit(./**)",
            "Write(./**)",
            "Glob(./**)",
            "Grep(./**)",
            "Bash(go:*)",
            "Bash(make:*)",
            "Bash(gofmt:*)",
            "Bash(golangci-lint:*)",
            "Bash(goreleaser:*)",
            "Bash(gh:*)",
            "Bash(govulncheck:*)",
            "Bash(deadcode:*)"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./.env.*)",
            "Read(./secrets/**)",
            "Bash(rm -rf:*)",
            "Bash(sudo:*)",
            "Bash(git commit --no-verify:*)"
        ]
    },
    "sandbox": {
        "filesystem": {
            "allowWrite": ["//tmp", "//private/tmp/claude", "~/Library/Caches/go-build", "~/.cache/go-build", "~/Library/Caches/golangci-lint"]
        },
        "network": {
            "allowedHosts": ["vuln.go.dev"]
        }
    }
}
