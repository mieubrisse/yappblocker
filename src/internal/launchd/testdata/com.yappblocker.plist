<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.yappblocker</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/yappblocker</string>
        <string>run</string>
    </array>
    <key>StartInterval</key>
    <integer>120</integer>
    <key>StandardOutPath</key>
    <string>/Users/someone/Library/Application Support/yappblocker/yappblocker.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/someone/Library/Application Support/yappblocker/yappblocker.log</string>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
